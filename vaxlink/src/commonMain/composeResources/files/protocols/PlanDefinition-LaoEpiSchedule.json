              "valueString": "birthDate"
            },
            {
              "url": "offset",
              "valueString": "P0D"
            },
            {
              "url": "windowBefore",
              "valueString": "P0D"
            },
            {
              "url": "windowAfter",
              "valueString": "P7D"
            }
          ]
        }
      ],
      "condition": [
        {
          "kind": "applicability",
          "expression": {
            "language": "text/fhirpath",
            "expression": "%immunizations.entry.resource.where(vaccineCode.coding.where(system='https://nawitech.github.io/vaxlink-ig/CodeSystem/lao-epi-schedule-dose' and (code='HB0-24H' or code='HB0-7D')).exists() and status='completed').empty()"
          }
