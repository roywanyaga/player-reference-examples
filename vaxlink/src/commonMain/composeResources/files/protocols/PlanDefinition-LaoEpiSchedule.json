{
  "resourceType": "PlanDefinition",
  "id": "LaoEpiSchedule",
  "url": "https://nawitech.github.io/vaxlink-ig/PlanDefinition/LaoEpiSchedule",
  "title": "Lao PDR immunization schedule, birth to first birthday",
  "description": "The Lao PDR Expanded Programme on Immunization schedule from the Ministry of Health 2026 list, as a protocol over a child's immunization history. One Task per dose not yet given, due by age.",
  "name": "LaoEpiSchedule",
  "status": "active",
  "date": "2026-11-01",
  "publisher": "Nawitech Limited",
  "extension": [
    {
      "url": "http://smartregister.org/fhir/StructureDefinition/enrollment",
      "extension": [
        {
          "url": "mode",
          "valueString": "auto"
        },
        {
          "url": "eligibility",
          "valueString": "Patient.birthDate > (today() - 5 years)"
        }
      ]
    }
  ],
