        },
        {
          "name": "recordedOn",
          "path": "recordedDate",
          "type": "http://hl7.org/fhir/StructureDefinition/dateTime"
        }
      ]
    }
  ],
  "name": "Condition",
  "status": "active",
  "resource": "Condition"
}
