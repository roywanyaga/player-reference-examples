{
  "resourceType": "https://sql-on-fhir.org/ig/StructureDefinition/ViewDefinition",
  "url": "http://ohs.dev/ViewDefinition/HouseholdMember",
  "fhirVersion": [
    "4.0.1"
  ],
  "select": [
    {
      "column": [
        {
          "name": "memberId",
          "path": "entity.reference.substring(8)",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        },
        {
          "name": "isHead",
          "path": "extension.where(url = 'http://smartregister.org/fhir/StructureDefinition/group-member-involvement').value.coding.where(code = 'primary-contact').exists()",
          "type": "http://hl7.org/fhir/StructureDefinition/boolean"
        }
      ],
      "forEach": "member.where(entity.reference.startsWith('Patient/'))"
    }
  ],
  "name": "HouseholdMember",
  "status": "active",
  "resource": "Group"
}
