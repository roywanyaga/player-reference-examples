        },
        {
          "name": "relationshipLabel",
          "path": "relationship.coding.display.first()",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        },
        {
          "name": "relatedName",
          "path": "name.text.first()",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        },
        {
          "name": "relatedPatientId",
          "path": "extension.where(url = 'https://nawitech.github.io/vaxlink-ig/StructureDefinition/related-patient').value.reference.substring(8).first()",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        }
      ]
    }
  ],
  "name": "Relationship",
  "status": "active",
